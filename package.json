    "debug": "ts-node-dev --no-notify --respawn src",
    "seed-dummy": "ts-node scripts/seedDummy.ts",
    "generate-token": "ts-node scripts/generateToken.ts",
    "test-queries": "ts-node scripts/testQueries.ts"
  },
