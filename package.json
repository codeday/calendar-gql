    "apollo-server-express": "^2.16.1",
    "class-validator": "^0.12.2",
    "dotenv": "^8.2.0",
    "email-validator": "^2.0.4",
    "express": "^4.17.1",
    "front-matter": "^4.0.2",
    "graphql": "^15.3.0",
